{
  "name": "fenix-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "escritorio": "vite build --mode escritorio && electron .",
    "build:escritorio": "vite build --mode escritorio",
    "dist:win": "vite build --mode escritorio && electron-builder --win nsis --x64 --publish never",
    "probar:bd": "node scripts/probar-esquema.cjs",
    "publicar:win": "vite build --mode escritorio && electron-builder --win nsis --x64 --publish always"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "electron-updater": "^6.8.11",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.90.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0"
  },
  "productName": "FENIX APP",
  "description": "Finanzas personales para conductores de InDrive y Uber (datos guardados en la PC)",
  "author": "FENIX APP",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.fenixapp.finanzas",
    "productName": "FENIX APP",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "artifactName": "FENIX-APP-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FENIX APP",
      "language": "3082"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "fenixoficial1112",
        "repo": "finanzas",
        "releaseType": "release"
      }
    ]
  }
}
